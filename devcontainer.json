{
  "name": "Smart Parking Java + MySQL",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Smart Parking Web App",
      "onAutoForward": "openBrowser"
    }
  },
  "remoteEnv": {
    "DB_URL": "jdbc:mysql://mysql:3306/smart_parking?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC",
    "DB_USER": "parking",
    "DB_PASSWORD": "parking_demo_password"
  },
  "postCreateCommand": "java -version && mvn -version"
}
